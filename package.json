{
  "name": "aegis-digital-trust-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Local frontend asset pipeline for the AEGIS Flask application.",
  "scripts": {
    "build:css": "tailwindcss --config tailwind.config.cjs --input frontend/tailwind.css --output backend/app/static/css/tailwind.css --minify",
    "build:turbo": "node scripts/build-frontend-assets.cjs",
    "build:assets": "pnpm run build:css && pnpm run build:turbo",
    "verify:assets": "pnpm run build:assets"
  },
  "devDependencies": {
    "@hotwired/turbo": "8.0.12",
    "chart.js": "4.4.4",
    "tailwindcss": "3.4.17"
  }
}
